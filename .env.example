# Copy to .env. Do not commit the completed file.
# Optional: enables official Fed funds and Treasury observations in Macro Monitor.
FRED_API_KEY=

# Server and polling settings
DASHBOARD_PORT=8050
REFRESH_SECONDS=60
NEWS_REFRESH_SECONDS=300
MACRO_REFRESH_SECONDS=300

# Prediction-market (Polymarket) sentiment / macro-intelligence polling
POLYMARKET_REFRESH_SECONDS=900
POLYMARKET_SHIFT_HOURS=24
# Optional: comma-separated Polymarket slugs to always include (e.g. fed/cpi/bitcoin).
# Leave empty to rely on automatic keyword discovery of active markets.
POLYMARKET_SLUGS=

# Order-flow (CVD): number of recent aggregated trades to analyse per refresh.
CVD_TRADES_LIMIT=1000

# Research defaults only. This app never uses exchange credentials or sends orders.
SYMBOL=BTC/USDT
FUTURES_SYMBOL=BTC/USDT:USDT
MAX_RISK_PERCENT=1.0
MIN_RISK_REWARD=1.5

# ── Brain Memory — Anti-whipsaw (fixes 3:00 LONG 67k → 3:05 SHORT 67.1k) ─────
# Time that must pass before opposite signal allowed
SIGNAL_COOLDOWN_MINUTES=30
# Price must move at least this % to allow flip during cooldown
FLIP_PRICE_THRESHOLD_PCT=0.8
# Confidence needed to flip early
MIN_CONF_TO_FLIP=75
# Price diff below this = same thesis (deduplicate)
SAME_THESIS_PCT=0.3
MAX_FLIPS_PER_HOUR=2

# ── Portfolio Guardian — Fund Protection (portfolio > signal) ───────────
MAX_TOTAL_RISK_PERCENT=3.0
MAX_OPEN_TRADES=2
DAILY_LOSS_LIMIT_PCT=3.0
MAX_LEVERAGE=10
